rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may only read and write their own profile document,
    // keyed by their Firebase Auth uid. No other collections are defined yet.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
